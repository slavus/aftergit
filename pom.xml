<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.aftergit</groupId>
  <artifactId>aftergit-parent</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>
  <name>AfterGit</name>
  <description>Three-pane git conflict resolver for Eclipse and EGit</description>
  <url>https://github.com/slavus/aftergit</url>
  <licenses>
    <license>
      <name>EPL-2.0</name>
      <url>https://www.eclipse.org/legal/epl-2.0/</url>
    </license>
  </licenses>
  <scm>
    <url>https://github.com/slavus/aftergit</url>
    <connection>scm:git:https://github.com/slavus/aftergit.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jgit.version>7.6.0.202603022253-r</jgit.version>
    <junit.version>6.1.3</junit.version>
    <tycho.version>5.0.4</tycho.version>
    <!-- the target platform: Eclipse 2026-03 and its projects from download.eclipse.org; the profile local-eclipse
         switches to an installed Eclipse when -Daftergit.eclipse.home=/path/to/eclipse is given -->
    <aftergit.target.file>${maven.multiModuleProjectDirectory}/releng/aftergit-p2.target</aftergit.target.file>
  </properties>

  <modules>
    <module>bundles/net.aftergit.merge.core</module>
    <module>bundles/net.aftergit.merge.git</module>
    <module>bundles/net.aftergit.merge.git.tests</module>
    <module>bundles/net.aftergit.merge.jdt</module>
    <module>bundles/net.aftergit.merge.lsp</module>
    <module>bundles/net.aftergit.merge.ui</module>
    <module>bundles/net.aftergit.merge.mcp</module>
    <module>bundles/net.aftergit.merge.mcp.tests</module>
    <module>bundles/net.aftergit.merge.ai</module>
    <module>bundles/net.aftergit.merge.ai.tests</module>
    <module>releng/net.aftergit.merge.mcp.conformance</module>
    <module>features/net.aftergit.merge.jdt.feature</module>
    <module>features/net.aftergit.merge.lsp.feature</module>
    <module>features/net.aftergit.merge.feature</module>
    <module>features/net.aftergit.merge.mcp.feature</module>
    <module>features/net.aftergit.merge.ai.feature</module>
    <module>releng/net.aftergit.merge.site</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jgit</groupId>
        <artifactId>org.eclipse.jgit</artifactId>
        <version>${jgit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <pomDependencies>consider</pomDependencies>
          <target>
            <file>${aftergit.target.file}</file>
          </target>
          <environments>
            <environment><os>linux</os><ws>gtk</ws><arch>x86_64</arch></environment>
          </environments>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>biz.aQute.bnd</groupId>
          <artifactId>bnd-maven-plugin</artifactId>
          <version>7.4.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>local-eclipse</id>
      <activation>
        <property>
          <name>aftergit.eclipse.home</name>
        </property>
      </activation>
      <properties>
        <aftergit.target.file>${maven.multiModuleProjectDirectory}/releng/aftergit.target</aftergit.target.file>
      </properties>
    </profile>
    <profile>
      <id>ui-tests</id>
      <modules>
        <module>bundles/net.aftergit.merge.ui.tests</module>
        <module>bundles/net.aftergit.merge.mcp.ui.tests</module>
      </modules>
    </profile>
    <profile>
      <id>corpus</id>
      <modules>
        <module>releng/net.aftergit.merge.corpus</module>
      </modules>
    </profile>
  </profiles>
</project>
