      <description>%color.taken.strong.description</description>
    </colorDefinition>
    <colorDefinition id="net.aftergit.merge.color.current" categoryId="net.aftergit.merge.colors.current" label="%color.current" value="COLOR_LIST_SELECTION">
      <description>%color.current.description</description>
    </colorDefinition>
    <colorDefinition id="net.aftergit.merge.color.ai.strong" categoryId="net.aftergit.merge.colors.ai" label="%color.ai.strong" value="131,77,240">
      <description>%color.ai.strong.description</description>
    </colorDefinition>
    <colorDefinition id="net.aftergit.merge.color.ai.light" categoryId="net.aftergit.merge.colors.ai" label="%color.ai.light" value="239,230,255">
      <description>%color.ai.light.description</description>
    </colorDefinition>
  </extension>
  <extension point="org.eclipse.e4.ui.css.swt.theme">
    <stylesheet uri="css/dark.css">
      <themeid refid="org.eclipse.e4.ui.css.theme.e4_dark"/>
    </stylesheet>
    <stylesheet uri="css/light.css">
      <themeid refid="org.eclipse.e4.ui.css.theme.e4_default"/>
      <themeid refid="org.eclipse.e4.ui.css.theme.e4_classic"/>
      <!-- the System and High contrast themes of older Eclipse versions -->
      <themeid refid="org.eclipse.e4.ui.css.theme.e4_system"/>
      <themeid refid="org.eclipse.e4.ui.css.theme.high-contrast"/>
    </stylesheet>
  </extension>
  <!-- the Outline view asks the editor part; the Compare editor hands that to the adapter manager (Ruling 13) -->
  <extension point="org.eclipse.core.runtime.adapters">
    <factory adaptableType="org.eclipse.ui.IEditorPart" class="net.aftergit.merge.ui.StructureOutlineAdapterFactory">
      <adapter type="org.eclipse.ui.views.contentoutline.IContentOutlinePage"/>
    </factory>
  </extension>
</plugin>
