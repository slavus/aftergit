<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.aftergit</groupId>
    <artifactId>aftergit-parent</artifactId>
    <version>0.0.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>net.aftergit.merge.mcp.conformance</artifactId>
  <name>AfterGit MCP protocol conformance</name>
  <description>Compiles the protocol package of net.aftergit.merge.mcp on a plain classpath and checks it with
    the official MCP Java SDK client. Test only; not part of any feature.</description>

  <properties>
    <mcp.sdk.version>2.0.0</mcp.sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- mcp-core 2.0.0 asks for reactor-core 3.7.0, which is not in the local repository; 3.8.3 is -->
      <dependency>
        <groupId>io.projectreactor</groupId>
        <artifactId>reactor-core</artifactId>
        <version>3.8.3</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.13.2</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <version>${mcp.sdk.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson3</artifactId>
      <version>${mcp.sdk.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- schema validation of tool output; the test passes its own validator, and the validator's
             dependencies are not in the local repository -->
        <exclusion>
          <groupId>com.networknt</groupId>
          <artifactId>json-schema-validator</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <!-- the protocol package of the bundle, nothing else: it must build without Eclipse -->
    <sourceDirectory>${project.basedir}/../../bundles/net.aftergit.merge.mcp/src</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <includes>
            <include>net/aftergit/merge/mcp/protocol/**/*.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
